{
  "name": "time-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop time tracker",
  "author": "Tempo",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:1420 && electron . --dev\"",
    "desktop:run": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "^1.15.2",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "main": "electron/main.cjs"
}
